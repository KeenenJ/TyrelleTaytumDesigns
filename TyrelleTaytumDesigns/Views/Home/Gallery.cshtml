@{
    ViewData["Title"] = "Portfolio";
}

<!-- ========================================= -->
<!-- Hero -->
<!-- ========================================= -->

<section class="gallery-hero">

    <div class="container">

        <h1>Portfolio</h1>

        <p>
            Explore a selection of custom designs, creative process moments,
            and the story behind TyrelleTaytum Designs
        </p>

    </div>

</section>

<!-- ========================================= -->
<!-- Introduction -->
<!-- ========================================= -->

<section class="gallery-introduction">

    <div class="container">

        <h2>Designed With Purpose</h2>

        <p>
            Every garment begins with an idea and is brought to life through
            creativity, craftsmanship, and attention to detail. Here's a look
            at some of the work and moments behind the brand
        </p>

    </div>

</section>

<!-- ========================================= -->
<!-- Featured Designs -->
<!-- ========================================= -->

<section class="collection-section">

    <div class="container">

        <h2>Featured Designs</h2>

        <p>
            A showcase of custom garments created for special occasions,
            celebrations, and unforgettable moments
        </p>

        <div class="collection-grid">

            <img src="~/images/collections/IMG1.jpg" alt="Custom Design 1" />

            <img src="~/images/collections/IMG2.jpg" alt="Custom Design 2" />

            <img src="~/images/collections/IMG3.jpg" alt="Custom Design 3" />

            <img src="~/images/collections/IMG4.jpg" alt="Custom Design 4" />

            <img src="~/images/collections/IMG5.jpg" alt="Custom Design 5" />

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- Behind The Brand -->
<!-- ========================================= -->

<section class="collection-section">

    <div class="container">

        <h2>Behind The Brand</h2>

        <p>
            A glimpse into the creative process, inspiration,
            and craftsmanship behind every design.
        </p>

        <div class="collection-grid">

            <img src="~/images/behind-the-scene/BTS1.jpg" alt="Behind The Scenes" />

            <img src="~/images/behind-the-scene/BTS2.jpg" alt="Behind The Scenes" />

            <img src="~/images/behind-the-scene/BTS3.jpg" alt="Behind The Scenes" />

            <img src="~/images/behind-the-scene/BTS4.jpg" alt="Behind The Scenes" />

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- Meet The Designer -->
<!-- ========================================= -->

<section class="collection-section">

    <div class="container">

        <h2>Meet The Designer</h2>

        <p>
            Tyrelle Taytum 
            
            Passionate about creating elegant, personalized garments
            that celebrate individuality and confidence
        </p>

        <div class="collection-grid">

            <img src="~/images/designer/PP1.jpg" alt="Tyrelle Taytum" />

            <img src="~/images/designer/PP2.jpg" alt="Tyrelle Taytum" />

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- Closing CTA -->
<!-- ========================================= -->

<section class="gallery-closing">

    <div class="container">

        <h2>Your Story Could Be Next</h2>

        <p>
            Whether you're preparing for a wedding, matric dance,
            graduation, or special occasion, we'd love to bring
            your vision to life
        </p>

        <a asp-controller="Home"
           asp-action="CustomOrder"
           class="btn-primary">

            Begin Your Custom Journey

        </a>

    </div>

</section>
