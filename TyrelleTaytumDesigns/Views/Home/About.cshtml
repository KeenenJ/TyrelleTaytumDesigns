@{
    ViewData["Title"] = "About";
}

<!-- ========================================= -->
<!-- Hero -->
<!-- ========================================= -->

<section class="about-hero">

    <div class="container">

        <h1>The Story Behind TyrelleTaytum Designs</h1>

        <p>
            Fashion has always been a powerful tool for transformation—
            a way to express identity, inspire confidence, and celebrate
            individuality
        </p>

    </div>

</section>

<!-- ========================================= -->
<!-- Our Story -->
<!-- ========================================= -->

<section class="our-story">

    <div class="container">

        <div class="story-content">

            <div class="story-image">

                <img src="~/images/designer/pp1.jpg" alt="Tyrelle Tatum Designer" />

            </div>

            <div class="story-text">

                <h2>The Story Behind the Brand</h2>

                <p>
                    Fashion has always been a powerful tool for transformation
                </p>

                <p>
                    Fashion has always been more than clothing. 
                    It has been a way to express identity, build confidence, and step into the best version of yourself. 
                    What began as a personal journey became the inspiration behind TyrelleTatum Designs
                </p>

                <p>
                    Every garment is created with intention, helping each client express who they truly are through thoughtful design, 
                    craftsmanship, and a deeply personal experience
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- Mission & Vision -->
<!-- ========================================= -->

<section class="mission-vision">

    <div class="container">

        <div class="mission-card">

            <h2>Our Mission</h2>

            <p>
                To create transformative fashion that helps people connect with who they truly are. 
                Every piece is designed to inspire confidence, encourage self-expression, 
                and empower people to step into life with courage and purpose
            </p>

        </div>

        <div class="vision-card">

            <h2>Our Vision</h2>

            <p>
                To build a curated luxury universe centered around transformation and self-expression, 
                creating more than garments: a world where people feel inspired to become the best version of themselves.
            </p>

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- Core Values -->
<!-- ========================================= -->

<section class="values">

    <div class="container">

        <h2>Our Core Values</h2>

        <p> Every decision, every garment, and every client experience is guided by the values that define TyrelleTaytum Designs </p>

        <div class="values-grid">

            <div class="value-card">

                <h3>Authenticity</h3>

                <p>
                    Creating garments that reflect the individuality and true identity of every client
                </p>

            </div>

            <div class="value-card">

                <h3>Transformation</h3>

                <p>
                    Designing pieces that inspire confidence and help people become the best version of themselves
                </p>

            </div>

            <div class="value-card">

                <h3>Movement</h3>

                <p>
                    Celebrating growth, change, and the journey of continually evolving through fashion
                </p>

            </div>

            <div class="value-card">

                <h3>Curation</h3>

                <p>
                    Carefully considering every detail to create a meaningful, luxurious, and intentional experience
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- Meet the Designer -->
<!-- ========================================= -->

<section class="designer">

    <div class="container">

        <div class="designer-content">

            <div class="designer-text">

                <h2>Meet the Designer</h2>

                <p>
                    "Fashion has always been a powerful tool for transformation in my life.
                    What began as a deeply personal way of expressing myself grew into a passion
                    for helping others discover confidence through thoughtful, intentional design"
                </p>

                <p>
                    "Every garment created at TyrelleTatum Designs is rooted in authenticity,
                    craftsmanship, and the belief that clothing should do more than look beautiful.
                    It should help people feel like the very best version of themselves"
                </p>

            </div>

            <div class="designer-signature">

                <h4>Tyrelle Taytum</h4>

                <span>Founder & Creative Designer</span>

            </div>

            <div class="story-image">

                <img src="~/images/designer/pp2.jpg" alt="Tyrelle Taytum - Founder of TyrelleTaytum Designs" />

            </div>

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- Call To Action -->
<!-- ========================================= -->

<section class="about-cta">

    <div class="container">

        <h2>Begin Your Transformation</h2>

        <p>
            Every custom garment begins with a conversation. Whether you have a clear vision or just the first spark of an idea, 
            Tyrelle will work closely with you to create a piece that reflects your story, your individuality, and your confidence
        </p>

        <a asp-controller="Home"
           asp-action="CustomOrder"
           class="btn-primary">

            Book a Consultation

        </a>

    </div>

</section>