@{
    ViewData["Title"] = "Frequently Asked Questions";
}

<!-- ========================================= -->
<!-- Hero -->
<!-- ========================================= -->

<section class="faq-hero">

    <div class="container">

        <h1>Frequently Asked Questions</h1>

        <p>
            Every custom piece begins with a conversation.
            Here are some of the questions we're most often asked
            before beginning the design journey
        </p>

    </div>

</section>

<!-- ========================================= -->
<!-- FAQ -->
<!-- ========================================= -->

<section class="faq-section">

    <div class="container">

        <div class="faq-item">

            <h3>Do clients need to book a consultation?</h3>

            <p>
                Yes. Every custom design begins with a consultation.
                This allows us to discuss your vision, measurements,
                design preferences, and event requirements before
                the creation process begins
            </p>

        </div>

        <div class="faq-item">

            <h3>Do you require a deposit?</h3>

            <p>
                Yes. A 50% deposit is required before the manufacturing
                process begins
            </p>

        </div>

        <div class="faq-item">

            <h3>How long do custom garments usually take?</h3>

            <p>
                Production time is typically between 2–3 weeks,
                depending on the complexity of the garment.
                Consultations are recommended at least 2–3 months
                before your event date to allow sufficient planning
                and production time
            </p>

        </div>

        <div class="faq-item">

            <h3>Do you offer alterations?</h3>

            <p>
                Unfortunately, alterations are not currently offered
            </p>

        </div>

        <div class="faq-item">

            <h3>Do you offer delivery or collection?</h3>

            <p>
                Yes. Both delivery and collection options are available.
                Details can be discussed during your consultation
            </p>

        </div>

        <div class="faq-item">

            <h3>Can I send inspiration pictures?</h3>

            <p>
                Absolutely. Inspiration images, Pinterest boards,
                sketches, and reference photos are always welcome
                and help communicate your vision more clearly
            </p>

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- CTA -->
<!-- ========================================= -->

<section class="faq-cta">

    <div class="container">

        <h2>Still Have a Question?</h2>

        <p>
            We'd love to hear from you. Get in touch and let's
            discuss your vision.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="btn-primary">

            Contact Us

        </a>

    </div>

</section>
