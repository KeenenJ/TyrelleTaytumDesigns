@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="hero-content">
            <p class="eyebrow">BESPOKE FASHION • GQEBERHA</p>
            <h1>Fashion as a Tool for Transformation.</h1>
            <p class="hero-subtitle">Designed to make you feel unmistakably yourself.</p>
            <p class="hero-description">TyrelleTaytum Designs creates bespoke garments built around individuality, confidence, and the moments that matter.</p>
            <div class="hero-buttons">
                <a asp-controller="Home" asp-action="Gallery" class="btn-primary">View Collections</a>
                <a asp-controller="Home" asp-action="CustomOrder" class="btn-secondary">Begin Your Journey</a>
            </div>
        </div>
    </div>
</section>

<section class="featured-collections">
    <div class="container">
        <p class="eyebrow">THE PORTFOLIO</p>
        <h2>Featured Designs</h2>
        <p>A curated selection of handcrafted garments that turn ideas into wearable statements.</p>
        <div class="collection-grid">
            <div class="collection-card">
                <img src="~/images/collections/img1.jpg" alt="Black satin custom gown" loading="lazy" />
                <h3>Black Satin Gown</h3>
                <p>Timeless elegance with a modern, sculpted finish.</p>
            </div>
            <div class="collection-card">
                <img src="~/images/collections/img2.jpg" alt="Crimson sculpted custom dress" loading="lazy" />
                <h3>Crimson Sculpted Dress</h3>
                <p>A bold statement piece celebrating confidence and individuality.</p>
            </div>
            <div class="collection-card">
                <img src="~/images/collections/img3.jpg" alt="Ivory bridal custom gown" loading="lazy" />
                <h3>Ivory Bridal Gown</h3>
                <p>Designed for an unforgettable moment with effortless grace.</p>
            </div>
        </div>
        <div class="section-button"><a asp-controller="Home" asp-action="Gallery" class="btn-secondary">Explore The Portfolio</a></div>
    </div>
</section>

<section class="about-preview">
    <div class="container">
        <div class="about-content">
            <div class="about-image">
                <img src="~/images/designer/pp1.jpg" alt="Tyrelle Tatum, designer" loading="lazy" />
            </div>
            <div class="about-text">
                <p class="eyebrow">THE PHILOSOPHY</p>
                <h2>Designed With Purpose</h2>
                <p>Fashion should be more than clothing. It should express individuality, build confidence, and help you step into the best version of yourself.</p>
                <p>Every garment is thoughtfully created around the person wearing it — from the first conversation to the final detail.</p>
                <a asp-controller="Home" asp-action="About" class="btn-secondary">Discover The Story</a>
            </div>
        </div>
    </div>
</section>

<section class="why-us">
    <div class="container">
        <p class="eyebrow">THE EXPERIENCE</p>
        <h2>Why Choose TyrelleTaytum Designs?</h2>
        <p>A personal design experience where your story, style, and confidence shape the garment.</p>
        <div class="features-grid">
            <div class="feature-card"><h3>Tailored Craftsmanship</h3><p>Thoughtful construction, collaboration, and attention to detail from concept to completion.</p></div>
            <div class="feature-card"><h3>Personal Design</h3><p>Your vision leads the process, with the design shaped around your personality and occasion.</p></div>
            <div class="feature-card"><h3>Handcrafted Detail</h3><p>Carefully considered materials, finishing, and construction create a garment with character.</p></div>
            <div class="feature-card"><h3>Made Around You</h3><p>No two clients are the same. Your garment is created specifically for your story.</p></div>
        </div>
    </div>
</section>

<section class="journey">
    <div class="container">
        <p class="eyebrow">FROM IDEA TO GARMENT</p>
        <h2>Your Design Journey</h2>
        <p>A collaborative process designed to turn your idea into something you can wear with confidence.</p>
        <div class="journey-grid">
            <div class="journey-step"><span>01</span><h3>Consultation</h3><p>Share your vision, inspiration, occasion, and direction.</p></div>
            <div class="journey-step"><span>02</span><h3>Design & Planning</h3><p>Your concept is refined into a design tailored to you.</p></div>
            <div class="journey-step"><span>03</span><h3>Craftsmanship</h3><p>The garment is carefully constructed with attention to every detail.</p></div>
            <div class="journey-step"><span>04</span><h3>Final Fitting</h3><p>We make sure the finished garment feels as good as it looks.</p></div>
        </div>
    </div>
</section>

<section class="custom-cta">
    <div class="container">
        <p class="eyebrow">YOUR NEXT LOOK</p>
        <h2>Bring Your Vision to Life</h2>
        <p>Whether you're preparing for a special occasion or simply want something completely unique, start with a conversation.</p>
        <a asp-controller="Home" asp-action="CustomOrder" class="btn-primary">Request a Consultation</a>
    </div>
</section>

<section class="instagram-preview">
    <div class="container">
        <p class="eyebrow">BEHIND THE BRAND</p>
        <h2>From Sketch to Finished Piece</h2>
        <p>Take a look behind the scenes at the creative process and craftsmanship behind the brand.</p>
        <div class="instagram-grid">
            <img src="~/images/behind-the-scene/BTS1.jpg" alt="TyrelleTaytum sewing and design process" loading="lazy" />
            <img src="~/images/behind-the-scene/BTS2.jpg" alt="TyrelleTaytum design process" loading="lazy" />
            <img src="~/images/behind-the-scene/BTS3.jpg" alt="TyrelleTaytum dressmaking process" loading="lazy" />
            <img src="~/images/behind-the-scene/BTS4.jpg" alt="TyrelleTaytum studio" loading="lazy" />
        </div>
        <a href="https://instagram.com/tyrelletaytum" target="_blank" rel="noopener noreferrer" class="btn-secondary">Follow The Journey</a>
    </div>
</section>
