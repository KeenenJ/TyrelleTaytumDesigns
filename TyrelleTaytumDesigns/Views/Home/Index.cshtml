@{
    ViewData["Title"] = "Home";
}

<!-- ========================= -->
<!-- Hero Section -->
<!-- ========================= -->
<section class="hero">

    <div class="hero-overlay"></div>

    <div class="container">

        <div class="hero-content">

            <h1>TyrelleTaytum Designs</h1>

            <p class="hero-subtitle">
                Fashion as a Tool
                for Transformation
            </p>

            <p class="hero-description">
                Creating bespoke garments that inspire confidence,
                self-expression, and the courage to become the best
                version of yourself
            </p>

            <div class="hero-buttons">

                <a asp-controller="Home"
                   asp-action="Gallery"
                   class="btn-primary">
                    View Collections
                </a>

                <a asp-controller="Home"
                   asp-action="CustomOrder"
                   class="btn-secondary">
                    Begin your Journey
                </a>

            </div>

        </div>
    </div>

</section>

<!-- ========================= -->
<!-- Featured Collections -->
<!-- ========================= -->
<section class="featured-collections">

    <div class="container">

        <h2>Featured Designs</h2>

        <p>
            A curated selection of handcrafted garments that reflect
            creativity, craftsmanship, and Tyrelle's passion for
            transforming ideas into wearable art
        </p>

        <div class="collection-grid">

            <div class="collection-card">
                <img src="~/images/collections/img1.jpg" />
                <h3>Black Satin Gown</h3>
                <p>
                    Crafted with timeless elegance and
                    modern sophistication
                </p>
            </div>
            

            <div class="collection-card">
                <img src="~/images/collections/img2.jpg" />
                <h3>Crimson Sculpted Dress</h3>
                <p>
                    A bold statement piece celebrating
                    confidence and individuality
                </p>
            </div>
            

            <div class="collection-card">
                <img src="~/images/collections/img3.jpg" />
                <h3>Ivory Bridal Gown</h3>
                <p>
                    Designed for unforgettable moments
                    with effortless grace
                </p>
            </div>
            

        </div>

        <div class="section-button">

            <a asp-controller="Home"
               asp-action="Gallery"
               class="btn-primary">
                View Portfolio
            </a>

        </div>

    </div>

</section>

<!-- ========================= -->
<!-- About Preview -->
<!-- ========================= -->
<section class="about-preview">

    <div class="container">

        <div class="about-content">

            <div class="about-image">
                <img src="~/images/designer/pp1.jpg" alt="Tyrelle Tatum Designer"/>
            </div>

            <div class="about-text">

                <h2>Designed with Purpose</h2>

                <p>
                    TyrelleTaytum Designs is built on the belief that fashion
                    should be more than clothing—it should be an expression
                    of individuality, confidence, and timeless elegance.
                </p>

                <p>
                    Every garment is thoughtfully created with exceptional
                    craftsmanship and attention to detail, ensuring each
                    client receives a piece as unique as they are.
                </p>

                <a asp-controller="Home"
                   asp-action="About"
                   class="btn-secondary">
                    Learn More
                </a>

            </div>

        </div>

    </div>

</section>

<!-- ========================= -->
<!-- Why Choose Us -->
<!-- ========================= -->
<section class="why-us">

    <div class="container">

        <h2>Why Choose TyrelleTaytum Designs?</h2>

        <div class="features-grid">

            <div class="feature-card">

                <h3>Tailored Craftsmanship</h3>

                <p>
                    Every garment is thoughtfully created with craftsmanship,
                    collaboration, and a passion for bringing your vision to life
                </p>

            </div>

            <div class="feature-card">

                <h3>Personal Design Experience</h3>

                <p>
                    Every project begins with understanding your vision,
                    ensuring every design reflects your personality,
                    lifestyle, and confidence
                </p>

            </div>

            <div class="feature-card">

                <h3>Handcrafted Excellence</h3>

                <p>
                    Each garment is carefully constructed with attention
                    to detail, quality fabrics, and precision craftsmanship
                    from start to finish
                </p>

            </div>

            <div class="feature-card">

                <h3>Designed Around You</h3>

                <p>
                    No two clients are the same. Every piece is created
                    exclusively for you, making your garment as unique
                    as your story
                </p>

            </div>

            <div class="feature-card">

                <h3>Confidence Through Fashion</h3>

                <p>
                    Fashion should empower. Every design is created to help
                    you feel confident, comfortable, and unforgettable in
                    every moment
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ========================= -->
<!-- Custom Design CTA -->
<!-- ========================= -->
<section class="custom-cta">

    <div class="container">

        <h2>Bring Your Vision to Life</h2>

        <p>
            Whether you're preparing for a special occasion,
            designing your dream outfit, or looking for something
            completely unique, we're ready to bring your vision
            to reality
        </p>

        <a asp-controller="Home"
           asp-action="CustomOrder"
           class="btn-primary">
            Request a Quote
        </a>

    </div>

</section>

<!-- ========================================= -->
<!-- The Design Journey -->
<!-- ========================================= -->

<section class="journey">

    <div class="container">

        <h2>Your Design Journey</h2>

        <p>
            Creating a custom garment is a collaborative experience.
            Here's what you can expect when working with
            TyrelleTatum Designs
        </p>

        <div class="journey-grid">

            <div class="journey-step">

                <span>01</span>

                <h3>Consultation</h3>

                <p>
                    Share your vision, inspiration and occasion.
                    Together we'll discuss ideas, fabrics and
                    the perfect direction for your garment
                </p>

            </div>

            <div class="journey-step">

                <span>02</span>

                <h3>Design & Planning</h3>

                <p>
                    Your concept is refined into a unique design
                    tailored specifically to your measurements,
                    style and personality
                </p>

            </div>

            <div class="journey-step">

                <span>03</span>

                <h3>Craftsmanship</h3>

                <p>
                    Every detail is carefully handcrafted using
                    quality materials and precise construction
                    techniques
                </p>

            </div>

            <div class="journey-step">

                <span>04</span>

                <h3>Final Fitting</h3>

                <p>
                    The final adjustments ensure your garment
                    fits beautifully and feels exactly as
                    envisioned
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ========================= -->
<!-- Instagram Preview -->
<!-- ========================= -->
<section class="instagram-preview">

    <div class="container">

        <h2>Behind The Brand</h2>

        <p>
            Every garment begins with an idea, develops through careful
            craftsmanship, and ends as a piece made uniquely for its wearer.
            Take a look behind the scenes at the creative journey
        </p>

        <div class="instagram-grid">

            <img src="~/images/behind-the-scene/BTS1.jpg" alt="Sewing Tools">
            <img src="~/images/behind-the-scene/BTS2.jpg" alt="Design Sketches">
            <img src="~/images/behind-the-scene/BTS3.jpg" alt="Dress Form">
            <img src="~/images/behind-the-scene/BTS4.jpg" alt="Design Studio">

        </div>

        <a href="https://instagram.com/tyrelletaytum"
           target="_blank"
           class="btn-secondary">
            Follow on Instagram
        </a>

    </div>

</section>