@model TyrelleTaytumDesigns.Models.CustomOrderModel

@{
    ViewData["Title"] = "Begin Your Custom Journey";
}

<section class="journey-hero">
    <div class="container">
        <h1>Begin Your Custom Journey</h1>
        <p>Every bespoke garment begins with an idea. Tell us about your vision and let's create something beautifully unique together.</p>
    </div>
</section>

<section class="journey-intro">
    <div class="container">
        <h2>Your Vision Starts Here</h2>
        <p>Whether you're preparing for a wedding, special event, photoshoot, graduation, or simply looking for something designed exclusively for you, we'd love to hear your ideas.</p>
        <p>Complete the form below and we'll be in touch to discuss your design, timeline, and the next steps of your journey.</p>
    </div>
</section>

<section class="journey-form">
    <div class="container">
        <form asp-action="CustomOrder" method="post" enctype="multipart/form-data">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="form-success" role="status">@successMessage</div>
            }
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>

            <h2>About You</h2>
            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="e.g. Jane Doe" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmailAddress">Email Address</label>
                <input asp-for="EmailAddress" class="form-control" placeholder="e.g. jane@email.com" />
                <span asp-validation-for="EmailAddress" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +27 82 123 4567" />
                <span asp-validation-for="PhoneNumber" class="field-error"></span>
            </div>
            <div class="form-group">
                <label>Preferred Contact Method</label>
                <div class="contact-methods">
                    <label class="radio-option"><input asp-for="PreferredContact" type="radio" value="Email" /> Email</label>
                    <label class="radio-option"><input asp-for="PreferredContact" type="radio" value="Phone Call" /> Phone Call</label>
                    <label class="radio-option"><input asp-for="PreferredContact" type="radio" value="WhatsApp" /> WhatsApp</label>
                </div>
            </div>

            <h2>Your Design</h2>
            <div class="form-group">
                <label asp-for="GarmentType">What would you like us to create?</label>
                <select asp-for="GarmentType" class="form-control">
                    <option value="">Please select</option>
                    <option>Bridal Gown</option>
                    <option>Matric Dance Dress</option>
                    <option>Graduation Outfit</option>
                    <option>Evening Wear</option>
                    <option>Formal Suit</option>
                    <option>Custom Design</option>
                    <option>Alterations</option>
                    <option>Other</option>
                </select>
                <span asp-validation-for="GarmentType" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Vision">Tell Us About Your Vision</label>
                <textarea asp-for="Vision" class="form-control" rows="7" placeholder="e.g. I'm imagining an elegant fitted evening gown with a clean neckline, soft movement and a champagne-and-black colour palette..."></textarea>
                <span asp-validation-for="Vision" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Occasion">Occasion</label>
                <input asp-for="Occasion" class="form-control" placeholder="e.g. Wedding, Matric Dance, Graduation, Birthday..." />
                <span asp-validation-for="Occasion" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PreferredColours">Preferred Colours (Optional)</label>
                <input asp-for="PreferredColours" class="form-control" placeholder="e.g. Black, champagne, emerald green..." />
            </div>
            <div class="form-group">
                <label asp-for="EventDate">When is your Event?</label>
                <input asp-for="EventDate" class="form-control" />
            </div>

            <hr />

            <h2>Budget</h2>
            <div class="form-group">
                <label asp-for="Budget">Estimated Budget</label>
                <select asp-for="Budget" class="form-control">
                    <option value="">Please select</option>
                    <option>Below R2 000</option>
                    <option>R2 000 - R5 000</option>
                    <option>R5 000 - R10 000</option>
                    <option>R10 000+</option>
                    <option>I'm not sure yet</option>
                </select>
                <span asp-validation-for="Budget" class="field-error"></span>
            </div>

            <h2>Inspiration</h2>
            <div class="form-group">
                <label asp-for="InspirationImages">Upload inspiration photos, Pinterest images, or sketches</label>
                <input asp-for="InspirationImages" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,application/pdf" />
                <small class="form-hint">Optional • Images or PDF • Maximum 10 MB</small>
            </div>

            <div class="form-group">
                <label>Do you already have your measurements?</label>
                <div class="contact-methods">
                    <label class="radio-option"><input asp-for="HasMeasurements" type="radio" value="Yes" /> Yes</label>
                    <label class="radio-option"><input asp-for="HasMeasurements" type="radio" value="No" /> No</label>
                </div>
            </div>

            <button type="submit" class="btn-primary">Submit My Custom Journey</button>
        </form>
    </div>
</section>

<section class="journey-ending">
    <div class="container">
        <h2>Crafted With Care</h2>
        <p>Every design receives the same dedication, creativity, and attention to detail. We can't wait to bring your vision to life.</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
