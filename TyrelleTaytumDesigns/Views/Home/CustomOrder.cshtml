@model TyrelleTaytumDesigns.Models.CustomOrderModel

@{
    ViewData["Title"] = "Begin Your Custom Journey";
}

<section class="journey-hero">
    <div class="container">
        <h1>Begin Your Custom Journey</h1>
        <p>Every bespoke garment begins with an idea. Tell us about your vision and let's create something beautifully unique together</p>
    </div>
</section>

<section class="journey-intro">
    <div class="container">
        <h2 class="vision-starts-here">Your Vision Starts Here</h2>
        <p>Whether you're preparing for a wedding, special event, photoshoot, graduation, or simply looking for something designed exclusively for you, we'd love to hear your ideas.</p>
        <p>Complete the form below and we'll be in touch to discuss your design, timeline, and the next steps of your journey.</p>
    </div>
</section>

<section class="journey-form">
    <div class="container">
        <form asp-action="CustomOrder" method="post" enctype="multipart/form-data">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="form-success" role="status">@successMessage</div>
            }
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>

            <h2>About You</h2>
            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="e.g. Jane Doe" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmailAddress">Email Address</label>
                <input asp-for="EmailAddress" class="form-control" placeholder="e.g. jane@email.com" />
                <span asp-validation-for="EmailAddress" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +27 82 123 4567" />
                <span asp-validation-for="PhoneNumber" class="field-error"></span>
            </div>
            <div class="form-group">
                <label>Preferred Contact Method</label>
                <div class="contact-methods">
                    <label class="radio-option"><input asp-for="PreferredContact" type="radio" value="Email" /> Email</label>
                    <label class="radio-option"><input asp-for="PreferredContact" type="radio" value="Phone Call" /> Phone Call</label>
                    <label class="radio-option"><input asp-for="PreferredContact" type="radio" value="WhatsApp" /> WhatsApp</label>
                </div>
            </div>

            <h2>Your Design</h2>
            <div class="form-group">
                <label asp-for="GarmentType">What would you like us to create?</label>
                <select asp-for="GarmentType" class="form-control">
                    <option value="">Please select</option>
                    <option>Bridal Gown</option>
                    <option>Matric Dance Dress</option>
                    <option>Graduation Outfit</option>
                    <option>Evening Wear</option>
                    <option>Formal Suit</option>
                    <option>Custom Design</option>
                    <option>Alterations</option>
                    <option>Other</option>
                </select>
                <span asp-validation-for="GarmentType" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Vision">Tell Us About Your Vision</label>
                <textarea asp-for="Vision" class="form-control" rows="7" placeholder="e.g. I'm imagining an elegant fitted evening gown with a clean neckline, soft movement and a champagne-and-black colour palette..."></textarea>
                <span asp-validation-for="Vision" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Occasion">Occasion</label>
                <input asp-for="Occasion" class="form-control" placeholder="e.g. Wedding, Matric Dance, Graduation, Birthday..." />
                <span asp-validation-for="Occasion" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PreferredColours">Preferred Colours (Optional)</label>
                <input asp-for="PreferredColours" class="form-control" placeholder="e.g. Black, champagne, emerald green..." />
            </div>
            <div class="form-group">
                <label asp-for="EventDate">When is your Event?</label>
                <input asp-for="EventDate" class="form-control" />
            </div>

            <hr />

            <h2>Budget</h2>
            <div class="form-group">
                <label asp-for="Budget">Estimated Budget</label>
                <select asp-for="Budget" class="form-control">
                    <option value="">Please select</option>
                    <option>Below R2 000</option>
                    <option>R2 000 - R5 000</option>
                    <option>R5 000 - R10 000</option>
                    <option>R10 000+</option>
                    <option>I'm not sure yet</option>
                </select>
                <span asp-validation-for="Budget" class="field-error"></span>
            </div>

            <h2>Inspiration</h2>
            <div class="form-group">
                <label asp-for="InspirationImages">Upload inspiration photos, Pinterest images, or sketches</label>
                <input asp-for="InspirationImages" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,application/pdf" />
                <small class="form-hint">Optional • Images or PDF • Maximum 10 MB</small>
            </div>

            <div class="form-group">
                <label>Do you already have your measurements?</label>
                <div class="contact-methods">
                    <label class="radio-option"><input asp-for="HasMeasurements" type="radio" value="Yes" /> Yes</label>
                    <label class="radio-option"><input asp-for="HasMeasurements" type="radio" value="No" /> No</label>
                </div>
            </div>

            <div id="measurementsSection" class="measurements-section" hidden>
                <div class="measurements-heading">
                    <h3>Your Measurements</h3>
                    <p>Please enter the measurements you already have. Use the unit selected below.</p>
                    <div class="measurements-note">
                        <strong>Don't have every measurement? That's completely okay.</strong>
                        Enter the measurements you know and leave any others blank. Tyrelle can help with anything that's missing during the next step of your custom journey.
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="MeasurementUnit">Measurement Unit</label>
                    <select asp-for="MeasurementUnit" class="form-control">
                        <option value="cm">Centimetres (cm)</option>
                        <option value="in">Inches (in)</option>
                    </select>
                </div>

                <div class="measurement-grid">
                    <div class="form-group">
                        <label asp-for="Height">Height</label>
                        <input asp-for="Height" class="form-control" placeholder="e.g. 168 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="BustChest">Bust / Chest</label>
                        <input asp-for="BustChest" class="form-control" placeholder="e.g. 92 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Waist">Waist</label>
                        <input asp-for="Waist" class="form-control" placeholder="e.g. 74 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Hips">Hips</label>
                        <input asp-for="Hips" class="form-control" placeholder="e.g. 102 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ShoulderToShoulder">Shoulder to Shoulder</label>
                        <input asp-for="ShoulderToShoulder" class="form-control" placeholder="e.g. 40 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ShoulderToWaist">Shoulder to Waist</label>
                        <input asp-for="ShoulderToWaist" class="form-control" placeholder="e.g. 42 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Neck">Neck</label>
                        <input asp-for="Neck" class="form-control" placeholder="e.g. 36 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ArmLength">Arm Length</label>
                        <input asp-for="ArmLength" class="form-control" placeholder="e.g. 60 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="UpperArm">Upper Arm</label>
                        <input asp-for="UpperArm" class="form-control" placeholder="e.g. 30 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Wrist">Wrist</label>
                        <input asp-for="Wrist" class="form-control" placeholder="e.g. 16 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="WaistToFloor">Waist to Floor</label>
                        <input asp-for="WaistToFloor" class="form-control" placeholder="e.g. 110 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="FullGarmentLength">Full Garment Length</label>
                        <input asp-for="FullGarmentLength" class="form-control" placeholder="e.g. 145 (optional)" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Inseam">Inseam</label>
                        <input asp-for="Inseam" class="form-control" placeholder="e.g. 78 (optional)" />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-primary">Submit My Custom Journey</button>
        </form>
    </div>
</section>

<section class="journey-ending">
    <div class="container">
        <h2>Crafted With Care</h2>
        <p>Every design receives the same dedication, creativity, and attention to detail. We can't wait to bring your vision to life.</p>
    </div>
</section>

@section Styles {
    <style>
        .vision-starts-here {
            display: inline-block;
            background: linear-gradient(110deg, var(--lux-gold) 0%, var(--lux-gold) 38%, #ffffff 50%, var(--lux-gold) 62%, var(--lux-gold) 100%);
            background-size: 240% auto;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: visionShimmer 8s ease-in-out infinite;
        }

        @@keyframes visionShimmer {
            0%, 55% { background-position: 180% center; }
            100% { background-position: -80% center; }
        }

        .measurements-section {
            margin: 28px 0 34px;
            padding: 30px;
            background: var(--lux-soft);
            border: 1px solid var(--lux-line);
        }

        .measurements-heading h3 {
            margin-bottom: 8px;
            font-family: "Cormorant Garamond", serif;
            font-size: 1.8rem;
            font-weight: 500;
        }

        .measurements-heading p {
            margin-bottom: 16px;
            font-size: .9rem;
            color: var(--lux-muted);
        }

        .measurements-note {
            margin-bottom: 24px;
            padding: 14px 16px;
            border-left: 3px solid var(--lux-gold);
            background: rgba(255, 255, 255, .65);
            font-size: .9rem;
            line-height: 1.6;
            color: var(--lux-muted);
        }

        .measurements-note strong {
            display: block;
            margin-bottom: 3px;
            color: var(--lux-ink);
        }

        .measurement-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px 20px;
        }

        .measurement-grid .form-group {
            margin-bottom: 0;
        }

        @@media (max-width: 640px) {
            .measurement-grid {
                grid-template-columns: 1fr;
            }

            .measurements-section {
                padding: 22px;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const section = document.getElementById('measurementsSection');
            const radios = document.querySelectorAll('input[name="HasMeasurements"]');

            function toggleMeasurements() {
                const hasMeasurements = document.querySelector('input[name="HasMeasurements"]:checked')?.value === 'Yes';
                section.hidden = !hasMeasurements;
            }

            radios.forEach(radio => radio.addEventListener('change', toggleMeasurements));
            toggleMeasurements();
        });
    </script>
}
