<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TyrelleTaytum Designs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luxury-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-gallery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/launch-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form-validation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/faq.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-eyebrows.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/button-rounding.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gallery-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about-polish.css" asp-append-version="true" />
    <style>
        .brand-lockup { display: flex; align-items: center; gap: 14px; }
        .brand-copy { display: flex; flex-direction: column; justify-content: center; }
        .brand-copy-main { font-family: "Cormorant Garamond", serif; font-size: 1.45rem; letter-spacing: .18rem; font-weight: 600; color: var(--black); line-height: 1.05; }
        .brand-copy-sub { margin-top: 3px; font-size: .58rem; letter-spacing: .32rem; color: var(--light-text); text-transform: uppercase; }
        .navbar-logo-image { width: 88px; height: 62px; object-fit: contain; object-position: center; flex: 0 0 auto; }
        .footer-brand-lockup { display: flex; align-items: center; gap: 14px; margin-bottom: 8px; }
        .footer-brand-copy { display: flex; flex-direction: column; justify-content: center; }
        .footer-brand-name { font-family: "Cormorant Garamond", serif; font-size: 1.45rem; letter-spacing: .16rem; font-weight: 600; color: #ffffff; line-height: 1.05; }
        .footer-brand-designs { margin-top: 3px; font-size: .58rem; letter-spacing: .28rem; color: rgba(255,255,255,.65); text-transform: uppercase; }
        .footer-logo-image { width: 105px; height: 78px; object-fit: contain; object-position: center; flex: 0 0 auto; }
        @@media(max-width:768px) {
            .brand-copy-main { font-size: 1.2rem; }
            .brand-copy-sub { font-size: .5rem; letter-spacing: .25rem; }
            .navbar-logo-image { width: 78px; height: 54px; }
            .footer-brand-lockup { align-items: flex-start; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="logo brand-lockup" asp-controller="Home" asp-action="Index" aria-label="Tyrelle Taytum Designs home">
                    <img class="navbar-logo-image" src="~/images/logo/TyrelleTaytum_Logo_Black_Transparent.png" alt="Tyrelle Taytum Designs" />
                    <span class="brand-copy">
                        <span class="brand-copy-main">Tyrelle Taytum</span>
                        <span class="brand-copy-sub">Designs</span>
                    </span>
                </a>

                <ul class="nav-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                    <li><a asp-controller="Home" asp-action="About">About</a></li>
                    <li><a asp-controller="Home" asp-action="CustomOrder">Custom Journey</a></li>
                    <li><a asp-controller="Home" asp-action="FAQ">FAQ</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main>@RenderBody()</main>

    <footer class="footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <div class="footer-brand-lockup">
                    <img class="footer-logo-image" src="~/images/logo/TyrelleTaytum_Logo_White_Transparent.png" alt="Tyrelle Taytum Designs" />
                    <div class="footer-brand-copy">
                        <span class="footer-brand-name">Tyrelle Taytum</span>
                        <span class="footer-brand-designs">Designs</span>
                    </div>
                </div>
                <p>Fashion as a Tool for Transformation</p>
            </div>

            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                    <li><a asp-controller="Home" asp-action="About">About</a></li>
                    <li><a asp-controller="Home" asp-action="CustomOrder">Custom Journey</a></li>
                    <li><a asp-controller="Home" asp-action="FAQ">FAQ</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
            </div>

            <div class="footer-contact">
                <h4>Contact</h4>
                <p>Email: Tyrelletaytumdesigns@gmail.com</p>
                <p>Phone: +27 63 689 4949</p>
                <p>Gqeberha, South Africa</p>
                <p>Business Hours: 10am - 6pm Mon - Fri, 10am - 2pm Sat</p>
            </div>

            <div class="footer-social">
                <h4>Follow Us</h4>
                <div class="social-links">
                    <a href="https://www.instagram.com/tyrelletaytum" target="_blank">Instagram • @@tyrelletaytum</a>
                    <a href="https://www.tiktok.com/@@tyrelletaytum" target="_blank">TikTok • @@tyrelletaytum</a>
                </div>
            </div>
        </div>

        <div class="copyright">
            <p>&copy; @DateTime.Now.Year TyrelleTaytum Designs. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
